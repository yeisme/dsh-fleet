#!/bin/sh
# Pre-commit guard for dsh-fleet.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# Three checks, each for a mistake this repo has actually made:
#  1. client.js is a COMMITTED build artifact. If it drifts from src/, the plugin ships code nobody reviewed, and HMR
#     quietly serves the stale bundle. `bun run check` catches both drift and a stale fixtures file.
#  2. A syntax error in the host half (index.js, lib/**) only surfaces when someone loads the plugin. `node --check` is
#     instant, so there is no reason not to.
#  3. This repository is PUBLIC. A home directory or an internal address in a staged file is a leak that cannot be
#     undone by a later commit. (Checked here, not in CI, because CI sees it only after it is on GitHub.)
#
# Deliberately NOT the full test suite: ~5 s on every commit trains people to use --no-verify. Tests run in CI and in
# .githooks/pre-push, where the cost is paid once instead of once per commit.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

fail() {
  printf '\n\033[31mpre-commit: %s\033[0m\n' "$1" >&2
  shift
  for line in "$@"; do printf '  %s\n' "$line" >&2; done
  printf '\n' >&2
  exit 1
}

# --- 1 + 2: the repo's own check (build deterministic, fixtures current) and host-half syntax -----------------
if command -v bun >/dev/null 2>&1; then
  bun run check >/dev/null 2>&1 || {
    bun run check 2>&1 | tail -20 >&2 || true
    fail "bun run check failed" \
      "client.js must match a fresh build of src/; fixtures/fleet.json must be current." \
      "Fix:  bun run build:client && bun run check"
  }
else
  printf 'pre-commit: bun not found, skipping the build-drift check\n' >&2
fi

# Only the staged JS, so an unrelated broken file in the tree cannot block this commit.
staged_js=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|mjs|jsx)$' || true)
if [ -n "$staged_js" ]; then
  for file in $staged_js; do
    [ -f "$file" ] || continue
    case "$file" in
      src/*.jsx) continue ;; # JSX has no plain `node --check`; the bundler is the check for these.
    esac
    node --check "$file" 2>/dev/null || {
      node --check "$file" >&2 2>&1 || true
      fail "syntax error in $file"
    }
  done
fi

# --- 3: nothing personal or internal in a public repo -------------------------------------------------------
leaks=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
  [ -f "$file" ] || continue
  # Only added lines: a pre-existing match in untouched context is not this commit's problem.
  git diff --cached -U0 -- "$file" | sed -n 's/^+\([^+]\)/\1/p' | grep -nE '/Users/[A-Za-z0-9._-]+|/home/[A-Za-z0-9._-]+|\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b' | sed "s|^|$file:|" || true
done)

if [ -n "$leaks" ]; then
  fail "personal path or internal address in staged changes" \
    "$leaks" \
    "" \
    "This repository is public. Replace the value with a neutral example before committing." \
    "If this is a false positive (e.g. a test fixture that must contain a path), extent the allow-list in .githooks/pre-commit."
fi

printf 'pre-commit: ok\n'
