{
  "name": "@local/dsh-threads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read and drive terminal-hosted agent threads (pi sessions, including herdr panes) inside the DSH Web UI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}
