{
  "name": "dsh-fleet",
  "version": "0.1.0",
  "type": "module",
  "description": "在 DSH 里管理 herdr 的 agent 舰队：看会话、看状态、派活、答审批、中断。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "build:client": "bun scripts/build.mjs --write-client",
    "dev": "bun scripts/build.mjs --write-client --watch",
    "check": "bun scripts/build.mjs --check && node scripts/gen-fixtures.mjs --check",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeisme/dsh-fleet.git"
  },
  "homepage": "https://github.com/yeisme/dsh-fleet#readme",
  "bugs": {
    "url": "https://github.com/yeisme/dsh-fleet/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "herdr",
    "agent",
    "orchestration",
    "plugin"
  ],
  "author": "Yeisme"
}
